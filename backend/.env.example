# Copy this file to .env and fill in your own values.

# Self-hosted OmniRoute (npm install -g omniroute && omniroute):
ROUTER_BASE_URL=http://localhost:20128/v1
# OrcaRouter cloud instead:
# ROUTER_BASE_URL=https://api.orcarouter.ai/v1

# API key issued by whichever router you're using
ROUTER_API_KEY=your-router-api-key-here

# Port for this backend server
PORT=8787

# (Tùy chọn) Mật khẩu truy cập bảo vệ web khi đưa lên VPS/Internet
# Để trống nếu chỉ chạy local máy cá nhân.
APP_PASSWORD=
